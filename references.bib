@incollection{Dincer,
title = {Chapter 4 - Integration of conventional energy systems for multigeneration},
booktitle = {Integrated Energy Systems for Multigeneration},
publisher = {Elsevier},
pages = {143-221},
year = {2020},
isbn = {978-0-12-809943-8},
doi = {https://doi.org/10.1016/B978-0-12-809943-8.00004-2},
url = {https://www.sciencedirect.com/science/article/pii/B9780128099438000042},
author = {Ibrahim Dincer and Yusuf Bicer},
keywords = {Conventional energy system, Gas cycle, Steam cycle, Multigeneration energy system, Integrated energy, Energy analysis, Thermodynamic analysis},
abstract = {In this chapter, a general overview of gas and steam cycles is provided followed by a discussion of alternative combined systems for improving cycle efficiencies. Initially, individual cycles such as Rankine, Brayton, Kalina, etc. are introduced, followed by combined cycles such as Brayton-Kalina, Rankine-Brayton etc. Several detailed case studies are given to demonstrate the improvement potential of conventional energy systems: including compressed air storage integrated to gas turbine, steam-assisted gravity drainage integrated to underground coal gasification, and others. An integrated system for power, syngas, bitumen, and hydrogen generation together with a SAGD and UCG system is then designed and thermodynamically analyzed. This multigeneration system highlights the significance of multigeneration systems for regions containing both oil and coal resources that can be removed by using in-situ technologies. By determination of each state point, component-based irreversibilities are found and their efficiencies are comparatively evaluated. The effects of particular working conditions on the subsystems and overall system performance are examined by performing parametric studies. The performance of the system under diverse ambient temperature, pressure and mass flow rate values is observed and the results are deliberated. The energy efficiencies of subsystems are given for SOFC, electrolysis, Brayton cycle, IGCC plant, UCG process, and SAGD process; the energy and exergy efficiencies of the overall system are also calculated.}
},
