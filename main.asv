%%1.1
clear all;
Km = 6.8528;
Alpha = 3.2737;
num = [Km];
den = [1 Alpha 0];
open_loop = tf(num,den);
figure;
t = linspace(0,3.5,100000);
open_loop = step(open_loop,t);
figure;
plot(t, open_loop)
title('Open Loop Step Response');
xlabel('Time (s)');
ylabel('Amplitude');
%% 1.5
closed_loop = tf([Km],[1 Alpha Km]);
figure
step(open_loop,t)

%% 1.6
KTask1 = 0.824;
five_pecernt_overshoot = tf([KTask1*Km],[1 Alpha Km*KTask1]);
step(five_pecernt_overshoot,t)

%% 2.3
K_16 = tf([1.6*KTask1*Km], [1 Alpha 1.6*KTask1*Km])
K_= tf([0.8*KTask1*Km], [1 Alpha 0.8*KTask1*Km])

K_08 = tf([0.8*KTask1*Km], [1 Alpha 0.8*KTask1*Km])
